{% load static %}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Receita - Consulta</title>

    <link rel="stylesheet" href="{% static 'static/styles/estilos.css' %}">

</head>

<body>

<div class="layout-principal">


    <aside class="barra-lateral">

        <div>

            <div class="marca">

                <span class="ponto"></span>

                Sistema Hospitalar

            </div>


            <nav class="menu-lateral">

                <a
                    href="{% url 'medico:painel' %}"
                    class="item-menu ativo"
                >

                    <span class="icone-menu">
                        💊
                    </span>

                    Atendimento

                </a>


                <a
                    href="{% url 'medico:perfil' %}"
                    class="item-menu"
                >

                    <span class="icone-menu">
                        👤
                    </span>

                    Perfil

                </a>

            </nav>

        </div>


        <div class="item-sair">

            <a
                href="{% url 'medico:logout_medico' %}"
                class="item-menu"
            >

                <span class="icone-menu">
                    ↪
                </span>

                Sair

            </a>

        </div>

    </aside>


    <main class="conteudo-principal">


        <header class="cabecalho-principal">

            <div>

                <span class="rotulo">
                    Receita
                </span>

                <h1>
                    Prescrição
                </h1>

                <p class="subtitulo">
                    Registre a receita do paciente durante o atendimento.
                </p>

            </div>

        </header>


        <section class="secao">


            <div class="cabecalho-secao">

                <h2>
                    Dados do paciente
                </h2>

            </div>


            <div class="grade-perfil">

                <div class="item-perfil">

                    <span class="rotulo-perfil">
                        Paciente
                    </span>

                    <span class="valor-perfil">
                        {{ atendimento.paciente.nome }}
                    </span>

                </div>


                <div class="item-perfil">

                    <span class="rotulo-perfil">
                        Especialidade
                    </span>

                    <span class="valor-perfil">
                        {{ atendimento.consulta.especialidade }}
                    </span>

                </div>


                <div class="item-perfil">

                    <span class="rotulo-perfil">
                        Data
                    </span>

                    <span class="valor-perfil">
                        {{ atendimento.consulta.data|date:"d/m/Y H:i" }}
                    </span>

                </div>

            </div>


        </section>


        <section class="secao">


            <div class="cabecalho-secao">

                <h2>
                    Registro da receita
                </h2>

            </div>


            <form
                method="POST"
                class="formulario-secao"
            >

                {% csrf_token %}


                <div class="campo">

                    <label for="medicamento">
                        Medicamento
                    </label>

                    <textarea
                        id="medicamento"
                        name="medicamento"
                        placeholder="Registre o medicamento..."
                    ></textarea>

                </div>


                <div class="campo">

                    <label for="dosagem">
                        Dosagem
                    </label>

                    <textarea
                        id="dosagem"
                        name="dosagem"
                        placeholder="Registre a dosagem..."
                    ></textarea>

                </div>


                <div class="campo">

                    <label for="frequencia">
                        Frequência
                    </label>

                    <textarea
                        id="frequencia"
                        name="frequencia"
                        placeholder="Registre a frequência de uso..."
                    ></textarea>

                </div>


                <div class="campo">

                    <label for="duracao">
                        Duração
                    </label>

                    <textarea
                        id="duracao"
                        name="duracao"
                        placeholder="Registre a duração do tratamento..."
                    ></textarea>

                </div>


                <div class="campo">

                    <label for="observacoes">
                        Observações
                    </label>

                    <textarea
                        id="observacoes"
                        name="observacoes"
                        placeholder="Registre orientações ou observações..."
                    ></textarea>

                </div>


                <button
                    type="submit"
                    class="botao-primario"
                >
                    Salvar receita
                </button>


            </form>


        </section>


    </main>

</div>

</body>
</html>